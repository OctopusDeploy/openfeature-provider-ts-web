{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        // Core runs in both browsers and Node, so neither DOM nor Node globals are in scope.
        "lib": ["ES2022"],
        // Jest's globals are for tests only. tsconfig.build.json removes them from the shipped code.
        "types": ["jest"],
        // Web consumes core's @internal declarations, so they must survive into core's .d.ts.
        "stripInternal": false
    },
    "exclude": ["node_modules", "dist"],
    "include": ["src/**/*"]
}
