{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        // Server runs only in Node, so Node's globals are in scope and the DOM lib is not, which makes window and
        // document compile errors. @types/node still declares localStorage and sessionStorage, so ESLint bans those.
        "lib": ["ES2020"],
        "types": ["jest", "node"]
    },
    "exclude": ["node_modules", "dist"],
    "include": ["src/**/*"]
}
