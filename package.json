{
    "name": "@octopusdeploy/openfeature",
    "version": "6.0.0",
    "description": "The Octopus Feature Flags OpenFeature Provider",
    "type": "commonjs",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "npm run clean && tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && node scripts/writeModuleMarkers.js",
        "lint:fix": "eslint . --fix",
        "lint": "eslint .",
        "lint:package": "publint --strict && attw --pack .",
        "prepare": "npm run build",
        "preversion": "npm run lint",
        "test": "jest --maxWorkers=4 --config=jest.config.js --ci --reporters=default --reporters=jest-junit",
        "test:package": "node scripts/smokeTestPackage.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OctopusDeploy/openfeature-provider-ts-web.git"
    },
    "keywords": [
        "octopus deploy",
        "openfeature",
        "feature flags",
        "feature toggles"
    ],
    "author": "Octopus Deploy",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/OctopusDeploy/openfeature-provider-ts-web/issues"
    },
    "homepage": "https://github.com/OctopusDeploy/openfeature-provider-ts-web#readme",
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^10.0.0",
        "@openfeature/web-sdk": "^1.10.0",
        "@types/jest": "^30.0.0",
        "@types/murmurhash3js-revisited": "^3.0.3",
        "@types/node": "^24.19.2",
        "@typescript/native": "npm:typescript@^7.0.2",
        "axios-mock-adapter": "^2.1.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-prettier": "^5.1.3",
        "jest": "^30.0.0",
        "jest-expect-message": "^1.1.3",
        "jest-extended": "^7.0.0",
        "jest-junit": "^17.0.0",
        "jest-localstorage-mock": "^2.4.26",
        "prettier": "^3.3.2",
        "publint": "^0.3.25",
        "ts-jest": "^29.4.4",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.65.0"
    },
    "dependencies": {
        "axios": "^1.16.0",
        "axios-retry": "4.5.0",
        "murmurhash3js-revisited": "3.0.0"
    },
    "peerDependencies": {
        "@openfeature/web-sdk": "^1.1.0"
    },
    "overrides": {
        "brace-expansion": "5.0.12"
    },
    "jest-junit": {
        "outputDirectory": "reports",
        "outputName": "jest-junit.xml",
        "ancestorSeparator": " › ",
        "uniqueOutputName": "false",
        "suiteNameTemplate": "{filepath}",
        "classNameTemplate": "{classname}",
        "titleTemplate": "{title}"
    }
}
