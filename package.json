{
    "name": "openfeature-provider-ts",
    "private": true,
    "workspaces": [
        "packages/*",
        "specification-tests"
    ],
    "scripts": {
        "build": "npm run build -w packages/core && npm run build -w packages/web",
        "lint:fix": "eslint . --fix",
        "lint": "eslint .",
        "lint:package": "npm run lint:package -w packages/core && npm run lint:package -w packages/web",
        "prepare": "npm run build",
        "test": "jest --maxWorkers=4 --config=jest.config.js --ci --reporters=default --reporters=jest-junit",
        "test:package": "npm run build && npm run test:package -w packages/web"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^10.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.19.2",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-prettier": "^5.1.3",
        "jest": "^30.0.0",
        "jest-expect-message": "^1.1.3",
        "jest-extended": "^7.0.0",
        "jest-junit": "^17.0.0",
        "prettier": "^3.3.2",
        "publint": "^0.3.25",
        "ts-jest": "^29.4.4",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.65.0"
    },
    "overrides": {
        "brace-expansion": "5.0.12"
    },
    "jest-junit": {
        "outputDirectory": "reports",
        "outputName": "jest-junit.xml",
        "ancestorSeparator": " › ",
        "uniqueOutputName": "false",
        "suiteNameTemplate": "{filepath}",
        "classNameTemplate": "{classname}",
        "titleTemplate": "{title}"
    }
}
