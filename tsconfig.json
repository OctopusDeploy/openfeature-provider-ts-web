{
    "compilerOptions": {
        "removeComments": false,
        "rootDir": "src",
        "outDir": "dist",
        "target": "ES2020",
        "allowJs": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "declaration": true,
        "stripInternal": true,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["jest", "node"]
    },
    "exclude": ["node_modules", "dist"],
    "include": ["src/**/*"]
}
